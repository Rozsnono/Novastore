# NovaStore API – környezeti változók sablonja.
# Másold .env.local néven, és töltsd ki. A .env.local NEM kerülhet gitbe (gitignore-olt).
# Az értékek itt csak helyőrzők, valódi titkot ide soha ne írj.

# --- Adatbázis ---
# MongoDB kapcsolat (kötelező)
MONGODB_URI=mongodb://user:password@host:27017/novastore

# --- WebDAV NAS (kötelező) ---
WEBDAV_URL=https://nas.example.com:5006
WEBDAV_USERNAME=webdav-user
WEBDAV_PASSWORD=change-me
# WebDAV gyökér (opcionális, alap: /novastore/apps)
WEBDAV_ROOT_PATH=/

# --- Admin / hitelesítés (kötelező) ---
# Az admin belépés mesterkulcsa
ADMIN_MASTER_KEY=change-me-long-random
# Session/felhasználói JWT aláírás, legalább 32 karakter
JWT_SECRET=change-me-at-least-32-characters-long-random

# --- NAS feltöltő/letöltő szolgáltatás ---
# A szolgáltatás alap URL-je. Az admin Beállítások oldalon is megadható (feltöltési és letöltési URL külön);
# ez a változó TARTALÉK, ha ott nincs érték. Legalább az egyik helyen meg kell adni.
UPLOAD_API_URL=https://storage.example.com
# Opcionális: a szolgáltatás feltöltési gyökere (pl. /EpochMedia); a /-lel kezdődő útvonalak abszolútak
UPLOAD_STORAGE_ROOT=
# A webes feltöltő célkönyvtára a kulcs mappájához képest (alap: novastore/apps)
NEXT_PUBLIC_UPLOAD_TARGET_DIR=novastore/apps

# --- Titkos kulcsok (ajánlott: az admin Beállítások oldalon megadni, titkosítva az adatbázisban) ---
# Ezek az env változók TARTALÉKKÉNT működnek, ha az admin felületen nincs érték megadva.
# Feltöltő API kulcs (tartalék)
UPLOAD_API_KEY=
# Az app–szerver közös titka a telefonnak küldött titkosításhoz (tartalék); egyezzen az app buildjével
APP_CLIENT_SECRET=

# --- Admin beállítások titkosítása (a Beállítások oldal mentéséhez KÖTELEZŐ) ---
# Legalább 32 karakteres véletlen titok; ezzel titkosítjuk az adatbázisban tárolt API kulcsokat.
# FIGYELEM: elvesztése/változtatása után a mentett kulcsokat újra meg kell adni.
SETTINGS_ENCRYPTION_KEY=

# --- Egyéb ---
# NEXT_PUBLIC_APP_URL=https://novastore.example.com   # jelenleg nem használja a kód
# ELAVULT: a NEXT_PUBLIC_ előtagú kulcs a böngészőbe kerülne, ezért a feltöltő már nem használja.
# Csak szerveroldali tartalékként olvassa a rendszer; töröld, és használd a Beállítások oldalt.
# NEXT_PUBLIC_UPLOAD_API_KEY=
# NEXT_PUBLIC_UPLOAD_API_URL=
